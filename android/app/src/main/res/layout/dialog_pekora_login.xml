<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pekora_login_instructions"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/vsTextSecondary" />

    <EditText
        android:id="@+id/login_user_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/pekora_login_user_id"
        android:inputType="text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/login_generate"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pekora_login_generate" />

    <TextView
        android:id="@+id/login_phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/vsTextPrimary"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/login_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/vsTextSecondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/login_verify"
        style="@style/Widget.Voidstrap.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pekora_login_verify" />
</LinearLayout>
